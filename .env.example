# Optional fallback when no existing local MCP connection is configured.
# Copy to .env, then fill in your own keys. Never commit .env.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Grok also accepts the standard XAI_API_KEY environment variable.
GROK_API_KEY=
# Optional model overrides also apply to existing local MCP connections.
# V4 Pro is available as deepseek-v4-pro; refresh connections after editing .env.
# DEEPSEEK_MODEL=deepseek-v4-pro
# GEMINI_MODEL=gemini-3.8-flash
# GROK_MODEL=grok-4.7
